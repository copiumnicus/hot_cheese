<?xml version="1.0" encoding="UTF-8"?>
<!--
  Code-signing entitlements for hot_cheese.

  The Secure Enclave KEK requires the signed binary to own its data-protection
  keychain items. That access is governed by `keychain-access-groups`, and the group
  must be prefixed by your Apple Team ID.

  BEFORE SIGNING: replace every `__TEAM_ID__` token below with your 10-character Apple
  Team ID (find it with: `security find-identity -v -p codesigning`, or in the Apple
  Developer portal under Membership). Example Team ID: `ABCDE12345`. A literal
  `<TEAM_ID>` cannot appear inside the XML values (the angle brackets would start a
  tag), so the bracket-free token `__TEAM_ID__` is used as the placeholder instead.

  - com.apple.application-identifier   : <team id>.<bundle id>  — the app identity.
  - com.apple.developer.team-identifier: <team id>              — your team.
  - keychain-access-groups             : the data-protection keychain group(s) this
                                         binary may read/write. The first entry is the
                                         app's own group; Secure Enclave key items are
                                         created in (and looked up from) it.

  A free Apple-ID "personal team" Apple Development identity is enough to satisfy these
  entitlements and exercise the Secure Enclave locally; a Developer ID Application
  certificate is needed for a stable, distributable signature (see scripts/sign.sh).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>__TEAM_ID__.com.cc.hot_cheese</string>
	<key>com.apple.developer.team-identifier</key>
	<string>__TEAM_ID__</string>
	<key>keychain-access-groups</key>
	<array>
		<string>__TEAM_ID__.com.cc.hot_cheese</string>
	</array>
</dict>
</plist>
